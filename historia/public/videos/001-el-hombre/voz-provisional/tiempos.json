  "frases": [
   {
    "desde": 0.3,
    "hasta": 2.53,
    "texto": "Se llamaba Alfonso Quiroz Norris."
   },
   {
    "desde": 2.98,
    "hasta": 6.07,
    "texto": "Nació en Lima en mil novecientos cincuenta y seis."
   },
   {
    "desde": 6.52,
    "hasta": 12.18,
    "texto": "De chico fue nadador de competencia y representó al Perú en categorías infantil y juvenil."
   },
   {
    "desde": 12.63,
    "hasta": 21.5,
