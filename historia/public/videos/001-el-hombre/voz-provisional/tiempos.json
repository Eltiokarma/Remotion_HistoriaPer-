 "s02": {
  "duracion": 32.0,
  "frases": [
   {
    "desde": 0.3,
    "hasta": 2.55,
    "texto": "Se llamaba Alfonso Quiroz Norris."
   },
   {
    "desde": 3.0,
    "hasta": 6.62,
    "texto": "Nació en Lima, en mil novecientos cincuenta y seis."
   },
   {
    "desde": 7.87,
    "hasta": 14.09,
    "texto": "De chico fue nadador de competencia: representó al Perú en las categorías infantil y juvenil."
   },
   {
    "desde": 15.54,
    "hasta": 24.28,
    "texto": "Marcos Cueto, historiador y amigo suyo desde los quince años, cuenta que esa disciplina de la piscina la llevó después a los archivos."
   },
