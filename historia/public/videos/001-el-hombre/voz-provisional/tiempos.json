 "s01": {
  "duracion": 49.34,
  "frases": [
   {
    "desde": 0.3,
    "hasta": 1.22,
    "texto": "Nueva York."
   },
   {
    "desde": 1.67,
    "hasta": 6.94,
    "texto": "Un historiador peruano revisa, con minuciosidad, las pruebas de imprenta."
   },
   {
    "desde": 7.39,
    "hasta": 10.41,
    "texto": "Es la traducción al español de su último libro."
   },
   {
    "desde": 11.86,
    "hasta": 14.82,
    "texto": "No le queda mucho tiempo, y lo sabe."
   },
   {
    "desde": 16.77,
    "hasta": 20.49,
    "texto": "En los agradecimientos escribe una línea que casi nadie lee."
   },
   {
    "desde": 20.94,
    "hasta": 26.48,
    "texto": "Les da las gracias a sus médicos por alargar estos días, para poder completar la tarea."
   },
   {
    "desde": 28.13,
    "hasta": 31.85,
    "texto": "Unas líneas más abajo celebra el nacimiento de su hijo."
   },
   {
    "desde": 33.9,
    "hasta": 36.0,
    "texto": "Murió en enero de dos mil trece."
   },
   {
    "desde": 42.65,
    "hasta": 44.24,
    "texto": "El libro salió en mayo."
   },
   {
    "desde": 45.89,
    "hasta": 49.34,
    "texto": "Este video es sobre ese hombre, y sobre lo que encontró."
   }
  ],
