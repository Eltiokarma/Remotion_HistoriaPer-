{
 "s00": {
  "duracion": 33.67,
  "frases": [
   {
    "desde": 0.3,
    "hasta": 9.25,
    "texto": "Desde mil ochocientos veinte, la corrupción le costó al Perú, en promedio, entre el tres y el cuatro por ciento de todo lo que produce."
   },
   {
    "desde": 10.1,
    "hasta": 11.22,
    "texto": "Cada año."
   },
   {
    "desde": 12.67,
    "hasta": 18.1,
    "texto": "Del presupuesto del Estado, de cada diez soles, se fueron entre tres y cuatro."
   },
   {
    "desde": 19.75,
    "hasta": 24.23,
    "texto": "No son casos sueltos: es el sistema, y viene desde la colonia."
   },
   {
    "desde": 25.88,
    "hasta": 28.13,
    "texto": "Lo calculó un historiador limeño."
   },
   {
    "desde": 29.38,
    "hasta": 31.72,
    "texto": "Y no llegó a ver su libro en español."
   }
