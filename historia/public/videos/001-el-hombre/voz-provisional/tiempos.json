 "s03": {
  "duracion": 46.82,
  "frases": [
   {
    "desde": 0.3,
    "hasta": 8.46,
    "texto": "En mil novecientos setenta y cuatro entra a la Universidad Católica, entre los primeros puestos del examen de admisión."
   },
   {
    "desde": 9.51,
    "hasta": 12.32,
    "texto": "El Perú vive el gobierno militar de Velasco."
   },
   {
    "desde": 12.77,
    "hasta": 14.11,
    "texto": "Reforma agraria."
   },
   {
    "desde": 14.56,
    "hasta": 15.96,
    "texto": "Nacionalizaciones."
   },
   {
    "desde": 16.41,
    "hasta": 20.35,
    "texto": "Un discurso que promete enterrar el pasado oligárquico."
   },
   {
    "desde": 21.8,
    "hasta": 24.2,
    "texto": "Quiroz no apoyó al régimen."
   },
   {
    "desde": 24.65,
    "hasta": 29.34,
    "texto": "Militó un tiempo en un pequeño partido trotskista que lo criticaba con dureza."
   },
   {
    "desde": 30.79,
    "hasta": 35.27,
    "texto": "Para un estudiante de esa época, la historia no era un curso más."
   },
   {
    "desde": 35.72,
    "hasta": 38.31,
    "texto": "Era la manera de responder una pregunta."
   },
   {
    "desde": 39.36,
    "hasta": 41.69,
    "texto": "¿El país estaba cambiando de verdad?"
   },
   {
    "desde": 42.14,
    "hasta": 43.87,
    "texto": "¿O repetía lo de siempre?"
   }
  ],
