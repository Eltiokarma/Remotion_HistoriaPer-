 "s01": {
  "duracion": 49.66,
  "frases": [
   {
    "desde": 0.3,
    "hasta": 1.22,
    "texto": "Nueva York."
   },
   {
    "desde": 1.67,
    "hasta": 6.86,
    "texto": "Nuestro historiador revisa, con minuciosidad, las pruebas de imprenta."
   },
   {
    "desde": 7.31,
    "hasta": 10.27,
    "texto": "Es la traducción al español de su último libro."
   },
   {
    "desde": 11.72,
    "hasta": 14.71,
    "texto": "No le queda mucho tiempo, y lo sabe."
   },
   {
    "desde": 16.66,
    "hasta": 20.4,
    "texto": "En los agradecimientos escribe una línea que casi nadie lee."
   },
   {
    "desde": 20.85,
    "hasta": 26.55,
    "texto": "Les da las gracias a sus médicos por alargar estos días, para poder completar la tarea."
   },
   {
    "desde": 28.2,
    "hasta": 31.87,
    "texto": "Unas líneas más abajo celebra el nacimiento de su hijo."
   },
   {
    "desde": 33.92,
    "hasta": 35.99,
    "texto": "Murió en enero de dos mil trece."
   },
   {
    "desde": 42.64,
    "hasta": 44.26,
    "texto": "El libro salió en mayo."
   },
   {
    "desde": 45.91,
    "hasta": 49.66,
    "texto": "Estos videos son sobre ese hombre, y sobre lo que encontró."
   }
  ],
